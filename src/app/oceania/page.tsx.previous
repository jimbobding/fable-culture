function Wave({
  top,
  bottom,
  flip = false,
}: {
  top: string;
  bottom: string;
  flip?: boolean;
}) {
  return (
    <div style={{ background: bottom }} className="-mt-px w-full overflow-hidden">
      <svg
        viewBox="0 0 1440 125"
        preserveAspectRatio="none"
        className={`block h-16 w-full sm:h-24 ${flip ? "scale-x-[-1]" : ""}`}
        aria-hidden="true"
      >
        <path
          d="M0 0H1440V38C1180 120 1010 10 780 70S330 110 0 42Z"
          fill={top}
        />
        <path
          d="M-10 48C300 120 470 10 780 80S1180 120 1450 48"
          fill="none"
          stroke="#172c2b"
          strokeWidth="9"
          strokeLinecap="round"
        />
        <path
          d="M-10 65C300 137 470 27 780 97S1180 137 1450 65"
          fill="none"
          stroke="#f9b54f"
          strokeWidth="5"
          strokeLinecap="round"
        />
      </svg>
    </div>
  );
}

function Photo({
  src,
  alt,
  className = "",
}: {
  src: string;
  alt: string;
  className?: string;
}) {
  if (!src) {
    return (
      <div
        className={`flex items-center justify-center bg-[#73c4bd] text-6xl ${className}`}
      >
        🌴
      </div>
    );
  }

  return (
    <img
      src={src}
      alt={alt}
      className={`h-full w-full object-cover ${className}`}
    />
  );
}

